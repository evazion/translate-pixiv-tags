{
    "compilerOptions": {
        "target": "ESNext",
        "strict": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "moduleResolution": "Node",
        "module": "ESNext",
        "lib": ["ESNext", "DOM"],
        "sourceMap": false,
        "inlineSources": false,
        "isolatedModules": true,
        "esModuleInterop": true,
        "noEmit": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "skipLibCheck": true,
        "paths": {
            "jquery": ["./src/types-jquery.d.ts"],
            "@types/jquery": ["./src/types-jquery.d.ts"],
            "@types/jquery/index.d.ts@3.5.33": ["./src/types-jquery.d.ts"],
            "node_modules/@types/jquery/index.d.ts": ["./src/types-jquery.d.ts"]
        }
    },
    "include": ["src"],
    "exclude": ["dist", "node_modules"]
}
