{
    "compilerOptions": {
        "target": "ESNext",
        "strict": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "moduleResolution": "bundler",
        "module": "preserve",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "sourceMap": false,
        "inlineSources": false,
        "isolatedModules": true,
        "esModuleInterop": true,
        "noEmit": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "skipLibCheck": true,
        "checkJs": true
    },
    "include": ["src"],
    "exclude": [
        "dist",
        "node_modules",
        "src/adapter-server.js",
        "src/adapters/*.js",
        "src/adapters/adapter.d.ts"
    ]
}
